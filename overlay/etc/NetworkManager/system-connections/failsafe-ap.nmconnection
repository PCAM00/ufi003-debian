# 应急 WiFi 热点:配置保留但默认不开启、也不自动连接。
# WiFi 默认是关着的(见 wifi-default-off.service),需要时:
#     nmcli radio wifi on
#     nmcli connection up failsafe-ap
# 关掉热点:  nmcli connection down failsafe-ap
[connection]
id=failsafe-ap
uuid=ab4e6032-1c5d-4e7f-a081-3c4d5e6f7082
type=wifi
autoconnect=false
autoconnect-priority=-10

[802-11-wireless]
ssid=openstick-failsafe
mode=ap
band=bg
channel=3

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
group=ccmp
pairwise=ccmp
psk=12345678

[ipv4]
method=shared
addresses=192.168.69.1/24

[ipv6]
method=ignore
