# 同一根 RNDIS 网线的“带 DHCP + NAT”版本,默认不自动启用。
# 用途:让插着的电脑插上就能上网(自动拿 10.42.0.x + 默认路由)。
# 启停请用:  /root/usb-mode.sh nat on   /   /root/usb-mode.sh nat off
[connection]
id=rndis-usb0-shared
uuid=9a3d5f21-0b4c-4d6e-9f70-2b3c4d5e6f71
type=ethernet
autoconnect=false

[ethernet]

[ipv4]
method=shared
addresses=10.42.0.1/24

[ipv6]
method=disabled

[match]
interface-name=usb*
