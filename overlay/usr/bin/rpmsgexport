#!/usr/bin/env python3
# rpmsgexport 的 Python 实现(等效 postmarketOS 的同名小工具)
# 用法(和 udev 规则一致): rpmsgexport /dev/rpmsg_ctrlX <通道名>
# 作用:向 rpmsg_ctrl 导出 modem 的 DIAG 通道,导出后 /dev/rpmsg/hexagon/DIAG 出现
import fcntl
import struct
import sys

# _IOW(0xb5, 0x01, struct rpmsg_endpoint_info): 44 字节 -> 0x402CB501
RPMSG_CREATE_EP = 0x402CB501
RPMSG_ADDR_ANY = 0xFFFFFFFF


def main():
    if len(sys.argv) != 3:
        print('用法: rpmsgexport <rpmsg_ctrl 设备> <通道名>', file=sys.stderr)
        return 1
    dev, name = sys.argv[1], sys.argv[2]
    info = struct.pack('<32sIII', name.encode(), RPMSG_ADDR_ANY, RPMSG_ADDR_ANY, 0)
    try:
        with open(dev, 'wb') as f:
            fcntl.ioctl(f.fileno(), RPMSG_CREATE_EP, info)
    except OSError as e:
        # 已经导出过会返回 EBUSY,不算错误
        if e.errno in (16,):  # EBUSY
            return 0
        print('rpmsgexport %s %s 失败: %s' % (dev, name, e), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
